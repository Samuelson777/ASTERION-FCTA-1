! ASTERION FCTA-1 V0.5 APDL template
! Units: mm, N, s, tonne, MPa
! Run in a folder containing the V0.3 line-model include.
/CLEAR
/FILNAME,ast_v05_docking
/INPUT,../../v0_3/apdl/asterion_line_model,inc
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
NSEL,S,LOC,X,-21000
D,ALL,ALL,0
ALLSEL,ALL
NSEL,S,LOC,X,21400
*GET,NN,NODE,0,COUNT
F,ALL,FX,-25000/NN
ALLSEL,ALL
OUTRES,ALL,ALL
SOLVE
FINISH
/POST1
SET,LAST
PRRSOL
PLDISP,2
PLNSOL,U,SUM
FINISH
