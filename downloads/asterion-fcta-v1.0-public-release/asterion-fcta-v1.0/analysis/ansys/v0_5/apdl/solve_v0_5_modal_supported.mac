! ASTERION FCTA-1 V0.5 APDL template
! Units: mm, N, s, tonne, MPa
! Run in a folder containing the V0.3 line-model include.
/CLEAR
/FILNAME,ast_v05_modal_supported
/INPUT,../../v0_3/apdl/asterion_line_model,inc
! Add reviewed remote masses before solving.
/SOLU
ANTYPE,MODAL
NSEL,S,LOC,X,-21000
D,ALL,ALL,0
ALLSEL,ALL
MODOPT,LANB,20
MXPAND,20,,,YES
OUTRES,ALL,ALL
SOLVE
FINISH
/POST1
SET,LIST
FINISH
