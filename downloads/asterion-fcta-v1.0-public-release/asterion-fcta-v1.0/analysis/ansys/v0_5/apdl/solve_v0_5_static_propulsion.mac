! ASTERION FCTA-1 V0.5 APDL template
! Units: mm, N, s, tonne, MPa
! Run in a folder containing the V0.3 line-model include.
/CLEAR
/FILNAME,ast_v05_propulsion
/INPUT,../../v0_3/apdl/asterion_line_model,inc
/SOLU
ANTYPE,STATIC
NSEL,S,LOC,X,-21000
D,ALL,ALL,0
ALLSEL,ALL
NSEL,S,LOC,X,-16000
NSEL,R,LOC,Y,-3200,3200
*GET,NN,NODE,0,COUNT
F,ALL,FX,12000/NN
ALLSEL,ALL
OUTRES,ALL,ALL
SOLVE
FINISH
/POST1
SET,LAST
PLDISP,2
PLNSOL,U,SUM
FINISH
