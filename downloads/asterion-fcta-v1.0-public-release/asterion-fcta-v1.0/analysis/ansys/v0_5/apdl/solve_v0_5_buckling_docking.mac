! ASTERION FCTA-1 V0.5 APDL template
! Units: mm, N, s, tonne, MPa
! Run in a folder containing the V0.3 line-model include.
/CLEAR
/FILNAME,ast_v05_buckling
/INPUT,../../v0_3/apdl/asterion_line_model,inc
/SOLU
ANTYPE,STATIC
PSTRES,ON
NSEL,S,LOC,X,-21000
D,ALL,ALL,0
ALLSEL,ALL
NSEL,S,LOC,X,21400
*GET,NN,NODE,0,COUNT
F,ALL,FX,-25000/NN
ALLSEL,ALL
SOLVE
FINISH
/SOLU
ANTYPE,BUCKLE
BUCOPT,LANB,10
MXPAND,10,,,YES
SOLVE
FINISH
/POST1
SET,LIST
FINISH
